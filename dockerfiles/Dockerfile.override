# Dockerfile.override for plausible/analytics (Community Edition)
# -----------------------------------------------------------------------------
# Replaces the upstream Dockerfile during the CI build.
# Copy into your fork at: dockerfiles/Dockerfile.override
#
# Why we keep an Alpine runtime base instead of distroless
# -------------------------------------------------------
# Plausible is an Elixir/OTP release. Two things make distroless/static
# unworkable:
#   1. The release contains ERTS, which dynamically links to libssl,
#      libcrypto, ncurses, libstdc++, libgcc, and musl libc.
#   2. Both /entrypoint.sh and bin/plausible (generated by `mix release`)
#      are POSIX shell scripts. They need /bin/sh to execute.
# distroless/static has no shell and no shared libs, distroless/cc:debug
# has both but its naming signals "not for production." Pinned Alpine
# matches what upstream tests against, so we stay close to the known-good
# config and accept the larger surface area.
#
# Differences from upstream Dockerfile:
#   - Both base images are digest-pinned (multi-arch manifest digests).
#     Upstream pins the tag only, so a fresh `docker build` against a new
#     base could silently shift the layer set between runs. Renovate is
#     configured (see renovate.json.example) to bump these on a schedule.
#   - certbot is removed from the runtime layer. The upstream CE image
#     bundles certbot to support deployments where Plausible terminates
#     TLS itself. That is not a sensible production posture: any operator
#     should run Plausible behind a reverse proxy (Caddy/Traefik/nginx)
#     that handles certs. Dropping certbot removes ~30 MB of Python
#     transitive dependencies — easily a third of the image's CVE
#     exposure on bad days.
#   - OCI labels are populated from ARG VERSION so `docker inspect`
#     identifies the image as our mirror build and surfaces the upstream
#     tag.
#
# Everything else is preserved: MIX_ENV=ce, USER 999 nonroot, ENTRYPOINT,
# EXPOSE 8000, VOLUME /var/lib/plausible, CMD ["run"]. No application
# source is patched — the build is byte-equivalent to upstream up to base
# image and apk package set.
#
# When upstream bumps Elixir/Erlang/Alpine in their Dockerfile (visible
# at https://github.com/plausible/analytics/blob/master/Dockerfile), the
# digests below MUST be bumped to match. Renovate's `pinDigests: true`
# handles this on the configured cadence; manual bump = look up the new
# tag on Docker Hub and replace both reference + digest.

ARG ALPINE_VERSION=3.22.2

#### Builder
FROM hexpm/elixir:1.19.4-erlang-27.3.4.6-alpine-${ALPINE_VERSION}@sha256:c129490fa75f7d00a28e293eb8ee5e00d1b7b34da03748b998369e41ef8a0a1e AS buildcontainer

ARG MIX_ENV=ce

ENV MIX_ENV=$MIX_ENV
ENV NODE_ENV=production
ENV NODE_OPTIONS=--openssl-legacy-provider

# Custom ERL_FLAGS are passed for (public) multi-platform builds to fix
# a qemu segfault. https://github.com/erlang/otp/pull/6340
ARG ERL_FLAGS
ENV ERL_FLAGS=$ERL_FLAGS

RUN mkdir /app
WORKDIR /app

RUN apk add --no-cache git "nodejs-current=23.11.1-r0" yarn npm python3 ca-certificates wget gnupg make gcc libc-dev brotli

COPY mix.exs ./
COPY mix.lock ./
COPY config ./config
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get --only ${MIX_ENV} && \
    mix deps.compile

COPY assets/package.json assets/package-lock.json ./assets/
COPY tracker/package.json tracker/package-lock.json ./tracker/

RUN npm install --prefix ./assets && \
    npm install --prefix ./tracker

COPY assets ./assets
COPY tracker ./tracker
COPY priv ./priv
COPY lib ./lib
COPY extra ./extra

RUN npm run deploy --prefix ./tracker && \
    mix assets.deploy && \
    mix phx.digest priv/static && \
    mix download_country_database && \
    mix sentry.package_source_code

WORKDIR /app
COPY rel rel
RUN mix release plausible

#### Runtime
FROM alpine:${ALPINE_VERSION}@sha256:4b7ce07002c69e8f3d704a9c5d6fd3053be500b7f1c69fc0d80990c2ad8dd412

# VERSION is injected by the CI workflow via --build-arg. We use it for
# OCI labels and to populate BUILD_METADATA so the running app surfaces
# its version in /api/health and the admin UI.
ARG VERSION
ARG MIX_ENV=ce
ENV MIX_ENV=$MIX_ENV
ENV LANG=C.UTF-8

# Synthesize BUILD_METADATA matching the schema upstream's metadata
# action emits. Keeps the version display in the UI populated; falls
# back to {} if VERSION is unset (smoke-test builds).
ARG BUILD_METADATA
ENV BUILD_METADATA=${BUILD_METADATA:-{\"labels\":{\"org.opencontainers.image.version\":\"${VERSION}\"}}}

LABEL org.opencontainers.image.source="https://github.com/plausible/analytics" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.title="plausible (mirror build)" \
      org.opencontainers.image.description="Hardened mirror build of plausible/analytics community-edition. Built by THEKROLL's oss-mirror-build pipeline." \
      org.opencontainers.image.vendor="THEKROLL"

RUN adduser -S -H -u 999 -G nogroup plausible

# APT_REFRESH is a daily UTC date string forwarded by the CI workflow.
# Despite the name (sized for the apt-using overrides in this pipeline),
# the same mechanism is needed here for apk: BuildKit hashes RUN layers
# on (parent + command string), so an unchanged Dockerfile would re-use
# the cached `apk upgrade` layer indefinitely and never pick up new
# Alpine security advisories. Threading the date into the command bumps
# the hash once per UTC day. Default `unset` keeps local builds working.
ARG APT_REFRESH=unset

# apk upgrade picks up any base-image CVE fixes published since the
# pinned digest was cut. Trivy reads the resulting installed-package set.
RUN echo "apt-refresh=${APT_REFRESH}" > /etc/.apt-refresh && \
    apk upgrade --no-cache && \
    apk add --no-cache openssl ncurses libstdc++ libgcc ca-certificates

COPY --from=buildcontainer --chmod=555 /app/_build/${MIX_ENV}/rel/plausible /app
COPY --chmod=755 ./rel/docker-entrypoint.sh /entrypoint.sh

RUN mkdir -p /var/lib/plausible && chmod ugo+rw -R /var/lib/plausible

USER 999
WORKDIR /app
ENV LISTEN_IP=0.0.0.0
ENTRYPOINT ["/entrypoint.sh"]
EXPOSE 8000
ENV DEFAULT_DATA_DIR=/var/lib/plausible
VOLUME /var/lib/plausible
CMD ["run"]
